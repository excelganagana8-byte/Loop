# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB URI, Atlas URI, or leave default for in-memory fallback in dev)
MONGODB_URI=mongodb://localhost:27017/loop

# Authentication (JWT)
JWT_SECRET=super-secret-loop-jwt-key-minimum-32-characters-long
JWT_EXPIRES_IN=7d

# Anthropic Claude AI Configuration (Server-side ONLY - never exposed to client)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
